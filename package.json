{
  "name": "demask-roi-desktop",
  "version": "1.1.1",
  "private": true,
  "description": "Screen-wide Lada BasicVSR++ ROI restoration overlay for Windows",
  "license": "AGPL-3.0",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:worker": "build-worker.cmd",
    "dist:portable": "npm run build:worker && set ELECTRON_BUILDER_COMPRESSION_LEVEL=5&& electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "43.1.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.demask.roi",
    "productName": "Demask ROI Lada",
    "artifactName": "Demask-ROI-${version}-portable.${ext}",
    "files": [
      "desktop/**/*",
      "python/**/*",
      "vendor/lada/lada/**/*",
      "vendor/lada/LICENSE.md",
      "vendor/lada/README.md",
      "LICENSE",
      "README.md",
      "package.json",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "worker-dist/lada-worker",
        "to": "lada-worker"
      },
      {
        "from": "models/lada_mosaic_restoration_model_generic_v1.2.pth",
        "to": "models/lada_mosaic_restoration_model_generic_v1.2.pth"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}
